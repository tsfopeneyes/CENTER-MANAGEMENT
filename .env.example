# Browser-safe Supabase settings. These are public identifiers, not admin credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep false during rollout. Change to true only after the kiosk_devices
# migration, kiosk-qr Edge Function, and function secrets are all applied.
VITE_HAIFN_ROTATING_QR_ENABLED=false

# Server/CLI only. Never prefix this with VITE_ and never commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Server/Edge Function only, if AI integration is added later.
OPENAI_API_KEY=
NOTION_API_KEY=
