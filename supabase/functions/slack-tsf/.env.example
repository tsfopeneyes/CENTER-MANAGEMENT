# Copy to .env.local for local testing. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
NOTION_API_KEY=
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# Recommended separate signing key for short-lived Slack confirmation buttons.
# If omitted, SLACK_SIGNING_SECRET is used.
TSF_ACTION_SIGNING_SECRET=

# Comma-separated Slack member IDs permitted to confirm writes. Use * for every workspace user.
# Leave empty to deny writes.
TSF_WRITE_ALLOWED_USER_IDS=

# Comma-separated Slack channel IDs where confirmed writes are allowed. Use * for every channel.
# Keep empty to deny writes everywhere, even if TSF_WRITE_ALLOWED_USER_IDS contains *.
TSF_WRITE_ALLOWED_CHANNEL_IDS=

# Optional names of the connected Notion data sources. Defaults: 노트 DB, 할 일 DB, 프로젝트 DB.
NOTION_NOTES_DATA_SOURCE_NAME=노트 DB
NOTION_TASKS_DATA_SOURCE_NAME=할 일 DB
NOTION_PROJECTS_DATA_SOURCE_NAME=프로젝트 DB
NOTION_DIVISIONS_DATA_SOURCE_NAME=부문

# Apply each data source's default Notion template (icon and layout) when available.
NOTION_USE_DEFAULT_TEMPLATES=true

# Optional: reject signed requests from every other Slack workspace.
SLACK_ALLOWED_TEAM_ID=

# Set false to immediately disable aggregated TSF web-app reads.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
TSF_WEBAPP_DATA_ENABLED=true
